// examples/calculator.rmv
// Запрос двух чисел через gud(), преобразование в int/dbl, сложение и вывод результата

print("=== Простой калькулятор на Rameev ===")

// Запрашиваем первое число и преобразуем его в целое (int)
num1 = int(gud("Введите первое число (целое): "))

// Запрашиваем второе число и преобразуем его в дробное (dbl)
num2 = dbl(gud("Введите второе число (дробное или целое): "))

// Сложение чисел
result = num1 + num2

// Вывод итогового результата
print("Первое число:", num1)
print("Второе число:", num2)
print("Результат сложения:", result)

