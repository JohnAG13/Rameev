// examples/password_check.rmv
// Запрос пароля через функцию gud() и проверка совпадения
// с помощью конструкции if/else и операторов сравнения (== и !=).

correct_password = "rameev_secret"

print("=== Проверка пароля ===")
input_password = gud("Введите пароль для доступа к системе: ")

// Проверка совпадения с помощью ==
if (input_password == correct_password) {
    print("Доступ разрешен! Добро пожаловать в систему.")
} else {
    // Дополнительная демонстрация оператора !=
    if (input_password != correct_password) {
        print("Ошибка: неверный пароль! Доступ заблокирован.")
    }
}

