// examples/list_ops.rmv
// Работа со списками: создание списка, добавление элемента через add(),
// удаление элемента по индексу через remove(), получение длины через len()
// и вывод элементов списка.

// 1. Создаем начальный список с числами
numbers = [10, 20, 30]
print("Исходный список:", numbers)
print("Длина списка:", len(numbers))

// 2. Добавляем новые элементы с помощью add(список, значение)
add(numbers, 40)
add(numbers, 50)
print("Список после добавления элементов 40 и 50:", numbers)
print("Новая длина списка:", len(numbers))

// 3. Доступ к элементу по индексу (индексация с нуля)
first_item = numbers[0]
print("Первый элемент (индекс 0):", first_item)

// 4. Удаление элемента по индексу с помощью remove(список, индекс)
// Удаляем элемент с индексом 1 (число 20)
remove(numbers, 1)
print("Список после remove(numbers, 1):", numbers)
print("Итоговая длина списка:", len(numbers))

