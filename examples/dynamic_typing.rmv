// examples/dynamic_typing.rmv
// Демонстрация динамической типизации в языке Rameev:
// переменная свободно меняет свой тип данных во время выполнения программы
// (с integer на string, list и none).

// 1. Инициализируем переменную числовым типом (integer)
val = 100
print("1. Тип integer, начальное значение:", val)

// Арифметические действия с числом
val += 25
print("   После сложения (val += 25):", val)

// 2. Меняем тип той же переменной на строку (string)
val = "Привет, Rameev!"
print("2. Переменная val теперь строка:", val)

// Операция конкатенации строк
val = val + " Динамическая типизация работает!"
print("   После конкатенации строк:", val)

// 3. Переменная принимает список (list)
val = [1, 2, 3, 4]
print("3. Переменная val теперь список:", val)

// 4. Переменная принимает пустое значение (none)
val = none
print("4. Переменная val сброшена в:", val)

